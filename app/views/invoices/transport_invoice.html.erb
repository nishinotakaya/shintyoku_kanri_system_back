<% def fmt_yen(n)
  return "" if n.nil?
  negative = n.negative?
  formatted = n.abs.to_s.reverse.scan(/\d{1,3}/).join(",").reverse
  negative ? "-#{formatted}" : formatted
end
_sender = setting                     # 請求元(乙=ドライバー)の情報
_client = client_name.to_s
_expenses = (defined?(advanced_expenses) && advanced_expenses) || []
_expense_total = _expenses.sum { |expense| expense.amount.to_i }
_item_rows = data[:items]
_blank_rows = [ 6 - _item_rows.size, 0 ].max      # 紙の原本と同じ 6 行の枠を保つ
_expense_blank_rows = [ 3 - _expenses.size, 0 ].max
_person_name = user.display_name.to_s
# 口座は設定の bank_info(自由入力)を 金融機関 / 口座番号 / 口座名義 の3行に割り当てる
_bank_lines = bank_info_text.to_s.split(/\r?\n/).map(&:strip).reject(&:empty?)
_issue_date = data[:issue_date] %>
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title>請求書 <%= data[:invoice_no] %></title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; }
  body {
    font-family: "Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", serif;
    color: #111;
    font-size: 12px;
    margin: 0;
    padding: 30px 34px;
    line-height: 1.5;
  }
  .head { position: relative; }
  .title {
    text-align: center;
    font-size: 24px;
    letter-spacing: 12px;
    font-weight: 700;
    border-bottom: 1.5px solid #111;
    width: 240px;
    margin: 0 auto 2px;
    padding-bottom: 2px;
  }
  .closing { text-align: right; font-size: 11px; margin-top: 2px; }
  .to-row { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 14px; gap: 16px; }
  .to-block { flex: 1; min-width: 0; }
  .to-name {
    font-size: 15px;
    border-bottom: 1px solid #111;
    display: inline-block;
    min-width: 240px;
    padding: 0 6px 2px;
  }
  .to-honorific { font-size: 15px; margin-left: 6px; }
  .subject { margin-top: 12px; font-size: 12px; }
  .subject .value { display: inline-block; min-width: 220px; border-bottom: 1px solid #bbb; padding-left: 4px; }
  .sender {
    width: 300px;
    border: 1px solid #111;
    padding: 6px 8px;
    font-size: 11px;
    line-height: 1.7;
  }
  .sender div { display: flex; }
  .sender .label { width: 62px; flex: none; }
  .sender .value { flex: 1; min-width: 0; word-break: break-all; }
  .lead { margin-top: 16px; font-size: 12px; }
  .amount {
    text-align: center;
    margin: 10px auto 16px;
    font-size: 17px;
    font-weight: 700;
    border-bottom: 1.5px solid #111;
    display: table;
    padding: 0 18px 3px;
    letter-spacing: 2px;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 1px solid #111; padding: 4px 6px; font-size: 11px; height: 22px; }
  th { text-align: center; font-weight: 700; letter-spacing: 2px; }
  .col-name { width: 18%; }
  .col-detail { width: 36%; }
  .col-days { width: 12%; }
  .col-price { width: 15%; }
  .col-total { width: 19%; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .center { text-align: center; }
  .sum-label { text-align: center; letter-spacing: 4px; }
  .section-label { margin: 14px 0 4px; font-size: 12px; }
  .bank { margin-top: 18px; width: 56%; }
  .bank th { width: 34%; letter-spacing: 4px; }
  .bank td { height: 24px; }
  .note { margin-top: 10px; font-size: 10px; color: #444; }
</style>
</head>
<body>
  <div class="head">
    <div class="title">請 求 書</div>
    <div class="closing"><%= _issue_date.year %>年 <%= _issue_date.month %>月 <%= _issue_date.day %>日締め分</div>
  </div>

  <div class="to-row">
    <div class="to-block">
      <div>
        <span class="to-name"><%= _client %></span><span class="to-honorific"><%= honorific %></span>
      </div>
      <div class="subject">件名：<span class="value"><%= subject_text %></span></div>
    </div>
    <div class="sender">
      <div><span class="label">会社名：</span><span class="value"><%= _sender.issuer_name %></span></div>
      <div><span class="label">住所：</span><span class="value"><%= [ _sender.postal_code.presence && "〒#{_sender.postal_code}", _sender.address.presence ].compact.join(" ") %></span></div>
      <div><span class="label">携帯：</span><span class="value"><%= _sender.tel %></span></div>
      <div><span class="label">電話：</span><span class="value"></span></div>
      <div><span class="label">FAX：</span><span class="value"></span></div>
      <div><span class="label">担当者：</span><span class="value"><%= _person_name %></span></div>
    </div>
  </div>

  <div class="lead">下記の通りご請求申し上げます。</div>

  <div class="amount">ご請求金額　￥<%= fmt_yen(data[:total]) %>　（税込）</div>

  <table>
    <thead>
      <tr>
        <th class="col-name">氏　名</th>
        <th class="col-detail">内　容</th>
        <th class="col-days">時間数</th>
        <th class="col-price">単価</th>
        <th class="col-total">合　計</th>
      </tr>
    </thead>
    <tbody>
      <% _item_rows.each do |item| %>
        <tr>
          <td><%= _person_name %></td>
          <td><%= item[:label] %></td>
          <td class="num"><%= item[:qty].to_f == item[:qty].to_i ? item[:qty].to_i : item[:qty].to_f %></td>
          <td class="num"><%= item[:unit_price].to_i.positive? ? fmt_yen(item[:unit_price].to_i) : "" %></td>
          <td class="num"><%= item[:amount].to_i.positive? ? fmt_yen(item[:amount].to_i) : "" %></td>
        </tr>
      <% end %>
      <% _blank_rows.times do %>
        <tr><td></td><td></td><td></td><td></td><td></td></tr>
      <% end %>
      <tr>
        <td class="sum-label" colspan="4">小　計</td>
        <td class="num"><%= fmt_yen(data[:subtotal]) %></td>
      </tr>
      <tr>
        <td class="sum-label" colspan="4">消 費 税　（<%= data[:tax_rate].to_i %>%）</td>
        <td class="num"><%= fmt_yen(data[:tax]) %></td>
      </tr>
      <tr>
        <td class="sum-label" colspan="4">合　計</td>
        <td class="num"><%= fmt_yen(data[:total]) %></td>
      </tr>
    </tbody>
  </table>

  <div class="section-label">立替金</div>
  <table>
    <thead>
      <tr>
        <th class="col-name">氏　名</th>
        <th class="col-detail">内　容</th>
        <th class="col-days">日付</th>
        <th class="col-price">数量</th>
        <th class="col-total">金　額</th>
      </tr>
    </thead>
    <tbody>
      <% _expenses.each do |expense| %>
        <tr>
          <td><%= _person_name %></td>
          <td><%= [ expense.purpose, expense.payee_or_line ].map(&:presence).compact.join(" / ") %></td>
          <td class="center"><%= expense.expense_date&.strftime("%-m/%-d") %></td>
          <td class="num">1</td>
          <td class="num"><%= fmt_yen(expense.amount.to_i) %></td>
        </tr>
      <% end %>
      <% _expense_blank_rows.times do %>
        <tr><td></td><td></td><td></td><td></td><td></td></tr>
      <% end %>
      <tr>
        <td class="sum-label" colspan="4">合計</td>
        <td class="num"><%= _expense_total.positive? ? fmt_yen(_expense_total) : "" %></td>
      </tr>
    </tbody>
  </table>

  <table class="bank">
    <tbody>
      <tr><th>金融機関</th><td><%= _bank_lines[0] %></td></tr>
      <tr><th>口座番号</th><td><%= _bank_lines[1] %></td></tr>
      <tr><th>口座名義</th><td><%= _bank_lines[2] %></td></tr>
    </tbody>
  </table>

  <% if note_text.present? %>
    <div class="note"><%= note_text %></div>
  <% end %>
</body>
</html>
